{
  "name": "hikyou-launcher",
  "private": true,
  "version": "26.1.0-beta.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --project tsconfig.node.json --noEmit",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "tauri": "bun scripts/tauri.mjs",
    "check:privacy": "bun scripts/check-privacy.mjs",
    "test:scripts": "bun test scripts/*.test.mjs && bun run test:controllers && node --test tests/frontend/isolation.test.mjs tests/frontend/modRequests.test.mjs",
    "test:controllers": "node --conditions=browser --test src/hooks/controllers.test.mjs",
    "test:ui": "node scripts/frontend-smoke.mjs",
    "check:version": "bun scripts/check-version.mjs",
    "check:auth-config": "bun scripts/check-auth-config.mjs",
    "check:release-version": "bun scripts/check-release-version.mjs",
    "set:version": "bun scripts/set-version.mjs",
    "release:prepare": "bun scripts/release.mjs prepare",
    "release:publish": "bun scripts/release.mjs publish",
    "release": "bun scripts/release.mjs release",
    "test:version": "bun test scripts/versioning.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@lucide/svelte": "1.61.0",
    "@tauri-apps/api": "2.12.0",
    "i18next": "26.4.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.5",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
