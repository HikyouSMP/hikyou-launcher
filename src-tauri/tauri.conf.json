{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hikyou Launcher",
  "version": "../package.json",
  "identifier": "io.github.hikyou-smp.hikyou-launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun scripts/check-bundle-inputs.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hikyou Launcher",
        "width": 750,
        "height": 470,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        },
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default", "game-log"],
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://cdn.modrinth.com; connect-src 'self' https://minotar.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ca-certificates"]
      },
      "rpm": {
        "depends": ["ca-certificates"]
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "wix": {
        "version": "26.0.65535.30006"
      }
    }
  }
}
